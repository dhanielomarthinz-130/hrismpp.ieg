DirectoryIndex index.php
Options -Indexes

# Lindungi file sensitif
<FilesMatch "^(config\.local(\.example)?\.php|database\.sql|README\.md|\.gitignore|App5R\.html|App6S\.html)$">
    Require all denied
</FilesMatch>

# File database & backup tidak boleh diunduh (berlaku juga tanpa mod_rewrite)
<FilesMatch "(?i)\.(sqlite|sqlite3|db|sqlite-wal|sqlite-shm|sql|bak|log)$">
    Require all denied
</FilesMatch>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "same-origin"
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Tentukan base path otomatis (bekerja di subfolder XAMPP maupun root domain hosting)
    RewriteCond %{REQUEST_URI}::$1 ^(.*?/)(.*)::\2$
    RewriteRule ^(.*)$ - [E=BASE:%1]

    # 0. Blokir folder database, backup & git
    RewriteRule ^(database|\.backup-ui|\.git)(/|$) - [F,L]

    # 1. index.php / Index.html dibuka langsung -> URL bersih /
    RewriteCond %{THE_REQUEST} \s/+(?:[^\s?]*/)?(?:index\.php|Index\.html)[\s?] [NC]
    RewriteRule ^(?:index\.php|Index\.html)$ %{ENV:BASE} [R=302,L]

    # 2. login.php dibuka langsung -> URL bersih /login
    RewriteCond %{THE_REQUEST} \s/+(?:[^\s?]*/)?login\.php[\s?] [NC]
    RewriteRule ^login\.php$ %{ENV:BASE}login [R=302,L]

    # 2b. /maintenance/<kunci> -> pintu masuk login saat maintenance
    RewriteRule ^maintenance/([^/]+)/?$ login.php?mt=$1 [L,QSA]

    # 3. /login -> login.php
    RewriteRule ^login/?$ login.php [L,QSA]

    # 3b. Monitoring 6S: alamat lama /5r (termasuk QR yang sudah dicetak) -> /6s,
    #     6s.php dibuka langsung -> /6s, lalu /6s -> 6s.php
    RewriteRule ^5r(\.php)?/?$ %{ENV:BASE}6s [R=301,L,QSA]
    RewriteCond %{THE_REQUEST} \s/+(?:[^\s?]*/)?6s\.php[\s?] [NC]
    RewriteRule ^6s\.php$ %{ENV:BASE}6s [R=302,L,QSA]
    RewriteRule ^6s/?$ 6s.php [L,QSA]

    # 4. Route halaman SPA -> index.php
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(dashboard|absensi|jadwal|request_os|request-os|wa|rekap|operator|bagian|pengaturan)/?$ index.php [L,QSA]
</IfModule>
